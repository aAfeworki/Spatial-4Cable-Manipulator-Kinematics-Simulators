# ====== Workspace Anchors (cube corners on top face) ======
W, D, H = 10.0, 10.0, 10.0  # width (x), depth (y), height (z)
anchors = {
    "FL": np.array([0.0, 0.0, H]),   # front-left-top
    "FR": np.array([W, 0.0, H]),     # front-right-top
    "BL": np.array([0.0, D, H]),     # back-left-top
    "BR": np.array([W, D, H])        # back-right-top
}

# ====== Forward Kinematics (4-Cable Spatial) - NONLINEAR SOLVER ======
def fk(L1, L2, L3, L4, x0=None, max_iter=200, tol=1e-6):
    """
    Nonlinear Gauss-Newton solver for sphere intersection:
      minimize sum_i (||p - a_i|| - L_i)^2

    Returns (x,y,z) or None on failure.
    """
    anchor_list = np.array(list(anchors.values()))
    lengths = np.array([L1, L2, L3, L4], dtype=float)

    # Initial guess: center of workspace, but z slightly positive
    if x0 is None:
        x = np.array([W / 2.0, D / 2.0, H / 2.0], dtype=float)
    else:
        x = np.array(x0, dtype=float)

    for it in range(max_iter):
        diffs = x - anchor_list  # shape (4,3)
        dists = np.linalg.norm(diffs, axis=1)  # shape (4,)
        # avoid zero distances
        dists = np.where(dists == 0.0, 1e-12, dists)

        # residuals: predicted length - given length
        r = dists - lengths  # shape (4,)

        # cost
        cost = 0.5 * np.sum(r**2)

        # Jacobian J_ij = (p_j - a_ij) / dist_i
        J = diffs / dists[:, None]  # shape (4,3)

        # Solve for Gauss-Newton step: (J^T J) delta = - J^T r
        JTJ = J.T @ J  # 3x3
        JTr = J.T @ r  # 3x1

        # damping for stability (Levenberg-Marquardt-ish)
        lam = 1e-6
        try:
            delta = np.linalg.solve(JTJ + lam * np.eye(3), -JTr)
        except np.linalg.LinAlgError:
            # fallback to least squares
            try:
                delta, *_ = np.linalg.lstsq(JTJ + lam * np.eye(3), -JTr, rcond=None)
            except Exception:
                return None

        x_new = x + delta

        if np.linalg.norm(delta) < tol:
            return float(x_new[0]), float(x_new[1]), float(x_new[2])

        x = x_new

    # last attempt: return current estimate if residuals reasonable
    final_res = np.linalg.norm(np.linalg.norm(x - anchor_list, axis=1) - lengths)
    if final_res < 1e-2:
        return float(x[0]), float(x[1]), float(x[2])

    return None

# ====== Globals ======
ani = None
is_paused = False
frame_index = 0
times, L1_list, L2_list, L3_list, L4_list = [], [], [], [], []
x_history, y_history, z_history = [], [], []

# ====== Animate function ======
def animate(i):
    global frame_index

    if is_paused or frame_index >= len(L1_list):
        return *lines, end_eff, trace, end_eff_text

    L1, L2, L3, L4 = (L1_list[frame_index], L2_list[frame_index],
                      L3_list[frame_index], L4_list[frame_index])

    pos = fk(L1, L2, L3, L4)

    if pos is None:
        frame_index += 1
        return *lines, end_eff, trace, end_eff_text

    x, y, z = pos

    # Update cables
    for idx, (key, anchor) in enumerate(anchors.items()):
        # set 2D projection data and 3D z separately
        lines[idx].set_data([anchor[0], x], [anchor[1], y])
        lines[idx].set_3d_properties([anchor[2], z])

    # End effector
    end_eff.set_data([x], [y])
    end_eff.set_3d_properties([z])

    # Trace
    x_history.append(x)
    y_history.append(y)
    z_history.append(z)
    trace.set_data(x_history, y_history)
    trace.set_3d_properties(z_history)

    # Info text
    end_eff_text.set_text(
        f"t={times[frame_index]:.2f}\n"
        f"L1={L1:.2f}, L2={L2:.2f}\nL3={L3:.2f}, L4={L4:.2f}\n"
        f"x={x:.2f}, y={y:.2f}, z={z:.2f}"
    )

    # Highlight row in text box
    text_box.tag_remove("highlight", "1.0", tk.END)
    line_number = f"{frame_index+1}.0"
    text_box.tag_add("highlight", line_number, f"{line_number} lineend")
    text_box.tag_config("highlight", background="yellow", foreground="black")
    text_box.see(line_number)

    frame_index += 1
    return *lines, end_eff, trace, end_eff_text

# ====== Run Trajectory ======
def run_trajectory():
    global ani, times, L1_list, L2_list, L3_list, L4_list
    global x_history, y_history, z_history, frame_index, is_paused

    raw_text = text_box.get("1.0", tk.END).strip()
    if not raw_text:
        messagebox.showwarning("Warning", "No data pasted!")
        return

    times, L1_list, L2_list, L3_list, L4_list = [], [], [], [], []
    for line in raw_text.splitlines():
        parts = line.split(",")
        if len(parts) >= 5:
            try:
                t = float(parts[0])
                Ls = list(map(float, parts[1:5]))
                times.append(t)
                L1_list.append(Ls[0])
                L2_list.append(Ls[1])
                L3_list.append(Ls[2])
                L4_list.append(Ls[3])
            except ValueError:
                continue

    if not L1_list:
        messagebox.showerror("Error", "Invalid data format!")
        return

    x_history, y_history, z_history = [], [], []
    frame_index = 0
    is_paused = False
    pause_btn.config(text="Pause")
    text_box.tag_remove("highlight", "1.0", tk.END)

    if ani:
        ani.event_source.stop()

    ani = animation.FuncAnimation(
        fig, animate,
        frames=len(L1_list),
        interval=500,
        blit=True,
        repeat=True,
        cache_frame_data=False
    )
    canvas.draw()

# ====== Pause/Resume ======
def toggle_pause():
    global is_paused
    is_paused = not is_paused
    pause_btn.config(text="Resume" if is_paused else "Pause")

# ====== Tkinter GUI ======
root = tk.Tk()
root.title("4-Cable Spatial Manipulator - Forward Kinematics Simulator")

frame = tk.Frame(root)
frame.pack(fill="both", expand=True)

text_box = scrolledtext.ScrolledText(frame, width=35, height=20, wrap=tk.WORD)
text_box.pack(side="left", fill="y", padx=5, pady=5)

# Example: vary the cable lengths so the solver has a non-flat Z path
example_text = "0,10,10,10,10\n1,9,11,10,10\n2,11,9,10,10\n3,10,10,11,9\n4,10,10,10,10"
text_box.insert(tk.END, example_text)

fig = plt.figure(figsize=(7,7))
ax = fig.add_subplot(111, projection="3d")
ax.set_xlim(-1, W+1)
ax.set_ylim(-1, D+1)
ax.set_zlim(0, H+2)
ax.set_title("4-Cable Spatial Manipulator - FK Animation")

# Draw workspace box
for (x0,y0) in [(0,0),(W,0),(0,D),(W,D)]:
    ax.plot([x0,x0],[y0,y0],[0,H],'k-')
for (y0,z0) in [(0,0),(D,0),(0,H),(D,H)]:
    ax.plot([0,W],[y0,y0],[z0,z0],'k-')
for (x0,z0) in [(0,0),(W,0),(0,H),(W,H)]:
    ax.plot([x0,x0],[0,D],[z0,z0],'k-')

# Anchors
for a in anchors.values():
    ax.plot([a[0]], [a[1]], [a[2]], 'ks', ms=8)

# Moving parts
lines = [ax.plot([], [], [], '-', lw=2)[0] for _ in range(4)]
end_eff, = ax.plot([], [], [], 'ro', markersize=8)
trace, = ax.plot([], [], [], 'r--', lw=1)
end_eff_text = ax.text2D(0.05, 0.95, '', transform=ax.transAxes, va="top")

canvas = FigureCanvasTkAgg(fig, master=frame)
canvas.get_tk_widget().pack(side="right", fill="both", expand=True)

button_frame = tk.Frame(root)
button_frame.pack(pady=5)

run_btn = tk.Button(button_frame, text="Run Trajectory", command=run_trajectory)
run_btn.pack(side="left", padx=5)

pause_btn = tk.Button(button_frame, text="Pause", command=toggle_pause)
pause_btn.pack(side="left", padx=5)

root.mainloop()
